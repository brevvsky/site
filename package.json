{
  "name": "brevvsky-assets",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node local/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "diagnose": "node scripts/diagnose.mjs",
    "cloudflare:login": "node node_modules/wrangler/bin/wrangler.js login",
    "cloudflare:whoami": "node node_modules/wrangler/bin/wrangler.js whoami",
    "deploy": "node node_modules/wrangler/bin/wrangler.js deploy",
    "publish": "node scripts/publish.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "wrangler": "^4.168.0"
  }
}
